{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe",
    "headless": true
  },
  "start_url": {
    "url": "http://localhost:3020/categories"
  },
  "environment": {
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "color_scheme": "dark",
    "timezone": "America/Los_Angeles"
  },
  "actions": [
    {
      "step_id": "loaded",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".category-tile:first-child"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "settled",
      "action": "wait_for_timeout",
      "duration_ms": 500
    }
  ],
  "capture": {
    "at_end": ["screenshot", "dom", "accessibility", "url"]
  }
}
