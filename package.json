{
  "name": "upswing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A size-aware trend radar and verified analyst for Twitch streamers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts --dev",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "demo": "npm run build && tsx src/server/index.ts --demo",
    "collect": "tsx scripts/cli.ts collect",
    "collect:once": "tsx scripts/cli.ts collect:once",
    "backfill:clips": "tsx scripts/cli.ts backfill:clips",
    "report": "tsx scripts/cli.ts report",
    "bot": "tsx scripts/cli.ts bot",
    "export-sample": "tsx scripts/cli.ts export-sample",
    "import-sample": "tsx scripts/cli.ts import-sample",
    "warm-codex": "tsx scripts/cli.ts warm-codex",
    "check": "tsc --noEmit && eslint . && vitest run",
    "test": "vitest run",
    "format": "prettier --write .",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/middie": "^9.3.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fontsource/inter": "^5.3.0",
    "@openai/codex-sdk": "^0.165.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "echarts": "^6.1.0",
    "fastify": "^5.12.7",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
